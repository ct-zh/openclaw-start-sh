{
  "manifest_version": 3,
  "name": "Local Network Capture",
  "version": "0.1.0",
  "description": "Captures all network traffic from a user-selected console tab and sends it to a local service.",
  "permissions": ["activeTab", "alarms", "debugger", "storage", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:37777/*"
  ],
  "action": {
    "default_title": "Local Network Capture",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
